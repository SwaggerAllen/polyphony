# Build artifacts
/_build/
/cover/
/deps/
/doc/
/.fetch
erl_crash.dump
*.ez
*.beam
/config/*.secret.exs
.elixir_ls/

# Environment
.env

# Digested assets from `mix assets.deploy` (phx.digest). The undigested build
# outputs priv/static/assets/app.{js,css} ARE committed so the app serves with
# no build step; only the digested copies + manifest are generated artifacts.
/priv/static/assets/*-*.css
/priv/static/assets/*-*.js
/priv/static/assets/*.gz
/priv/static/cache_manifest.json
